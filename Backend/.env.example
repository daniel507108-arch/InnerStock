# Copy to Backend/.env and fill in. Never commit the real .env.

# Required
ANTHROPIC_API_KEY=
JWT_SECRET_KEY=

# Optional - defaults to the local SQLite file (sqlite:///./innerstock.db).
# Set to the hosted Postgres URL only in the DEPLOYED environment (Vercel),
# not in your local .env, or local runs would use the production database.
DATABASE_URL=

# Deployed only - the frontend's public URL(s), comma-separated, so the
# browser is allowed to call this API, e.g. https://innerstock.vercel.app
ALLOWED_ORIGINS=

# Only for scripts/copy_database.py - the database to copy local data INTO.
TARGET_DATABASE_URL=

# Optional - brokerage (Wealthsimple) sync through SnapTrade, see
# snaptrade_sync.py. Leave the keys blank to turn the feature off.
#   SNAPTRADE_KEY_TYPE=personal   - a Personal key reads ONE person's brokerage,
#       so only the user whose email is SNAPTRADE_OWNER_EMAIL can use it.
#   SNAPTRADE_KEY_TYPE=commercial - developer keys: every user links their own
#       brokerage. Requires FIELD_ENCRYPTION_KEY (stores each user's SnapTrade
#       secret encrypted). Generate one with:
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#       Never change or lose it in production - users would have to reconnect.
SNAPTRADE_KEY_TYPE=personal
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_OWNER_EMAIL=
FIELD_ENCRYPTION_KEY=

SEC_USER_AGENT=

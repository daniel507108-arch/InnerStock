# Copy to Backend/.env and fill in. Never commit the real .env.

# Required
ANTHROPIC_API_KEY=
JWT_SECRET_KEY=

# Optional - defaults to the local SQLite file (sqlite:///./innerstock.db).
# Set to a hosted Postgres URL in a deployed environment.
DATABASE_URL=

# Optional - Wealthsimple sync through SnapTrade (see snaptrade_sync.py).
# A Personal SnapTrade key reads ONE person's brokerage accounts, so only the
# InnerStock user whose email matches SNAPTRADE_OWNER_EMAIL can use it.
# Leave blank to turn the feature off (the dashboard card stays hidden).
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_OWNER_EMAIL=

SEC_USER_AGENT=

# Copy to Backend/.env and fill in. Never commit the real .env.

# Required
ANTHROPIC_API_KEY=
JWT_SECRET_KEY=

# Optional - defaults to the local SQLite file (sqlite:///./innerstock.db).
# Set to the hosted Postgres URL only in the DEPLOYED environment (Vercel),
# not in your local .env, or local runs would use the production database.
DATABASE_URL=

# Deployed only - the frontend's public URL(s), comma-separated, so the
# browser is allowed to call this API, e.g. https://innerstock.vercel.app
ALLOWED_ORIGINS=

# Only for scripts/copy_database.py - the database to copy local data INTO.
TARGET_DATABASE_URL=

# Optional - Wealthsimple sync through SnapTrade (see snaptrade_sync.py).
# A Personal SnapTrade key reads ONE person's brokerage accounts, so only the
# InnerStock user whose email matches SNAPTRADE_OWNER_EMAIL can use it.
# Leave blank to turn the feature off (the dashboard card stays hidden).
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_OWNER_EMAIL=

SEC_USER_AGENT=
